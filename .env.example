# Load explicitly before running; do not commit real secrets.
JA_PORT=8791
JA_POLL_SECONDS=300
# Set this to your own firmware checkout (not the service directory).
# JA_SOURCE_DIR=/home/your-user/firmware
JA_ALLOW_JIRA_WRITE=0
# LAN mode: set JA_HOST=0.0.0.0 and explicitly list the machine's LAN IPs.
# JA_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.10
JA_LAN_AUTH=0
# Optional later: JA_LAN_AUTH=1 enables admin login using data/lan-password.
# JA_DATA_DIR=/absolute/private/data
# JA_JIRA_BIN=/absolute/path/to/jira
# JA_ELF_BIN=/absolute/path/to/elf-fetch
# Configure Feishu with scripts/configure_feishu.py; credentials remain local.
# JA_DASHBOARD_URL=http://192.168.1.10:8791

JA_AI_ENABLED=1
JA_CODEX_BIN=codex
# JA_AI_PROXY=http://127.0.0.1:7890
JA_AI_TIMEOUT=600
