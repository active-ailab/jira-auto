# Copy to ~/.config/jira-auto/service.env, chmod 600, then edit local paths.
# systemd EnvironmentFile syntax: do not source as shell code.
JA_DATA_DIR="/home/your-user/apps/jira-auto/data"
JA_SOURCE_DIR="/home/your-user/firmware"
JA_HOST="0.0.0.0"
JA_PORT="8791"
JA_ALLOWED_HOSTS="localhost,127.0.0.1,192.168.1.20"
JA_DASHBOARD_URL="http://192.168.1.20:8791"
JA_POLL_SECONDS="300"
JA_LAN_AUTH="0"
JA_ALLOW_JIRA_WRITE="0"
JA_AI_ENABLED="1"
JA_CODEX_BIN="/home/your-user/.local/bin/codex"
JA_AI_TIMEOUT="600"
JA_AI_PROXY=""
JIRA_AUTH_TYPE="basic"
TZ="Asia/Shanghai"
# Configure Jira, elf-fetch, Codex and Feishu with their own local login tools.
# Never put passwords, App Secrets, SSO tokens or personal identifiers here.
